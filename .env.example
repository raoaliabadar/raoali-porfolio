# Panda AI assistant — copy this file to `.env.local` for local development,
# and add the same variable in Vercel → Project → Settings → Environment Variables.
# Never commit the real key. It is only read on the server (app/api/chat/route.ts).
#
# Get a key at https://platform.claude.com/ (API keys). Without it, the panda still
# answers using offline replies built from lib/content.ts.
ANTHROPIC_API_KEY=
