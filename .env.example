# Copy this file to `.env.local` for local development, and add the same variables in
# Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# Achievement wall (framed certificates behind the desk, edited at /wall-editor).
# 1. Vercel -> your project -> Storage -> create a Blob store and connect it to this project.
#    That adds BLOB_READ_WRITE_TOKEN for you. Without it, local development saves to .wall-data/.
# 2. Set a password only you know; /wall-editor asks for it before uploading or saving.
WALL_EDITOR_PASSWORD=
