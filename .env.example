# Panda AI assistant — copy this file to `.env.local` for local development,
# and add the same variable in Vercel → Project → Settings → Environment Variables.
# Never commit the real key. It is only read on the server (app/api/chat/route.ts).
#
# Get a key at https://platform.claude.com/ (API keys). Without it, the panda still
# answers using offline replies built from lib/content.ts.
ANTHROPIC_API_KEY=

# Achievement wall (framed certificates behind the panda's desk, edited at /wall-editor).
# 1. Vercel -> your project -> Storage -> create a Blob store and connect it to this project.
#    That adds BLOB_READ_WRITE_TOKEN for you. Without it, local development saves to .wall-data/.
# 2. Set a password only you know; /wall-editor asks for it before uploading or saving.
WALL_EDITOR_PASSWORD=
